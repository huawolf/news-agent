{
    "mode": "slaver",
    "server_url": "",
    "output_language": "en",
    "content_languages": ["en"],
    "personal_preferences": "Track cross-sector investment signals: AI infrastructure, frontier tech, crypto on-chain flows, commodities supply gaps and macro policy shifts. Prefer primary sources, quantitative evidence and material changes over commentary.",
    "database": {
        "url": "",
        "schema": "news_agent",
        "sqlite_path": "data/news_agent.db"
    },
    "auth": {
        "main_url": "http://127.0.0.1:5678",
        "request_timeout": 10,
        "membership_database_url": ""
    },
    "schedule": {
        "fetch_interval_minutes": 60
    },
    "filter": {
        "min_score": 60,
        "max_age_hours": 24
    },
    "fetch": {
        "max_workers": 10,
        "timeout": 10
    },
    "tokenizer": {
        "user_dict": "",
        "extra_stopwords": []
    },
    "ranking": {
        "title_weight": 3.0,
        "k1": 1.5,
        "b": 0.75,
        "interest_match_bonus": 10.0,
        "source_weight": 5.0,
        "watchlist_bonus": 15.0,
        "recency_bonus": 10.0,
        "avoid_penalty": 20.0,
        "interest_keywords": [],
        "avoid_keywords": [],
        "source_weights": {}
    },
    "dedup": {
        "bm25_low_threshold": 40.0,
        "bm25_high_threshold": 100.0,
        "top_k": 10,
        "window_hours": 72,
        "same_source_bonus": 2.0,
        "max_query_tokens": 10
    },
    "sync": {
        "page_size": 200,
        "max_lookback_hours": 24
    },
    "report": {
        "batch_size": 200,
        "content_max_bytes": 8192,
        "path": "/api/mcp",
        "daily_limit_per_user": 100,
        "quota_timezone": "Asia/Shanghai",
        "retry_attempts": 3,
        "retry_backoff_seconds": 1.0
    },
    "mcp": {
        "server_name": "news-agent-master",
        "max_request_body_size": 4194304,
        "allowed_hosts": [],
        "allowed_origins": []
    },
    "llm": {
        "model": "openai/gpt-4o-mini",
        "baseUrl": "https://openrouter.ai/api/v1",
        "protocol": "openai_chat",
        "apiKeyName": "OPENROUTER_API_KEY",
        "request_timeout": 240,
        "max_prompt_chars": 300000,
        "max_concurrent_batches": 3,
        "batch_retry_delay_seconds": 300,
        "batch_max_retries": 1,
        "batch_consecutive_failure_threshold": 3,
        "prompts": {
            "translate_signal": "prompts/translate_signal.md",
            "score_batch": "prompts/score_batch.md",
            "immediate_push": "prompts/immediate_push.md",
            "digest": "prompts/digest.md",
            "section_github": "prompts/section_github.md",
            "insights": "prompts/insights.md",
            "watchlist_asset": "prompts/watchlist_asset.md"
        }
    },
    "translation": {
        "enabled": true,
        "concurrency": 4,
        "max_retry": 3,
        "batch_size": 10,
        "interval_minutes": 10
    },
    "delivery": {
        "timezone": "Asia/Shanghai",
        "schedules": [
            {
                "id": "push-1",
                "cron": "0 9 * * mon,tue,wed,thu,fri,sat,sun"
            },
            {
                "id": "push-2",
                "cron": "0 17 * * mon,tue,wed,thu,fri,sat,sun"
            }
        ],
        "push_limits": {
            "hot": 10,
            "watchlist": 10,
            "github": 3,
            "github_window_days": 30,
            "min_score": 80,
            "max_per_topic": 3
        }
    },
    "push": {
        "discord": {
            "enabled": false,
            "apiKeyName": "DISCORD_WEBHOOK_URL"
        },
        "feishu": {
            "enabled": true,
            "apiKeyName": "FEISHU_WEBHOOK_URL"
        },
        "telegram": {
            "enabled": false,
            "apiKeyName": "TELEGRAM_BOT_TOKEN",
            "chatId": ""
        },
        "custom": {
            "enabled": false,
            "apiKeyName": "CUSTOM_PUSH_URL",
            "tokenKeyName": "CUSTOM_PUSH_TOKEN"
        }
    },
    "log": {
        "retention_days": 30
    }
}
