# LLM API configuration
DEEPSEEK_API_KEY=sk-or-v1-...

# Feishu Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...

# Optional: higher free quota when tokens are provided; usually enough without them
# GITHUB_TOKEN=
# JINA_API_KEY=
# PH_TOKEN=

# Optional: protect local API clients (Web remains same-origin; MCP stdio does not use it)
# NEWS_AGENT_LOCAL_TOKEN=

# Optional: override the cross-platform user data directory or configuration path
# NEWS_AGENT_DATA_DIR=
# NEWS_AGENT_CONFIG=

# Optional: custom delivery platform configuration when custom delivery is enabled
# CUSTOM_PUSH_URL=https://your-custom-api.com/push
# CUSTOM_PUSH_TOKEN=your_custom_auth_token_here
