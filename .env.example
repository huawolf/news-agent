# Scoring LLM
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Push targets
FEISHU_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram push: bot token here, chat id in config.json (`push.telegram.chatId`)
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: higher free quota when tokens are provided
# GITHUB_TOKEN=
# JINA_API_KEY=

# Optional: verified manai-pic identities allowed to access the master backoffice.
# Each entry is a phone number or an email; use a comma-separated list or a JSON
# array. Emails match case-insensitively, phone numbers verbatim. Missing or
# empty means no administrator is granted.
# NEWS_AGENT_ADMINS=15500000000,admin@example.com
# Legacy single-value form, still honoured and merged into the list above:
# NEWS_AGENT_ADMIN_EMAIL=admin@example.com

# Optional: master PostgreSQL DSN. When empty, database.url from config.json is used.
# NEWS_AGENT_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5656/manai_pic
# NEWS_AGENT_MEMBERSHIP_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5656/manai_pic

# Optional: custom delivery platform configuration when custom delivery is enabled
# CUSTOM_PUSH_URL=https://your-custom-api.com/push
# CUSTOM_PUSH_TOKEN=your_custom_auth_token_here

# Optional: override the configuration path
# NEWS_AGENT_CONFIG=

# Optional: store the database and logs outside the project directory.
# NEWS_AGENT_DATA_DIR=~/.news-agent

# Optional: RSSHub instance used by RSSHub-backed sources.
# RSSHUB_BASE=https://rsshub.app

# Optional: BrowserWorker daemon used only for Feed-page collection.
# Defaults to port 12321 and the standard lock-file locations when unset.
# BrowserWorker_PORT=12321
# BrowserWorker_LOCK_FILE=~/.BrowserWorker/BrowserWorker.lock

# Shared ingestion key for the separate yield-pool snapshot upload path.
# The crawler sends this as its bearer credential and as the tool argument.
REPORTER_KEY=
